# Copy to .env at the repository root; backend loads it at startup.
# Process environment variables override .env values. Restart after changes.
# SQLite paths are relative to the working directory; start from backend/.
DATABASE_URL=sqlite:///./agrosphere.db
# Comma-separated origins, no trailing slash. Empty disables cross-origin access.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# false disables provider access; existing fresh POWER cache entries remain readable.
NASA_POWER_ENABLED=true
# Fresh-cache lifetime in seconds. Expiry creates a new immutable snapshot on success.
OBSERVATION_CACHE_TTL_SECONDS=86400

APP_ENV=development
# Grounded deterministic assistant is the safe default and needs no external key.
ASSISTANT_PROVIDER=deterministic
# To enable the optional OpenAI Responses API wording layer, install
# backend/requirements-assistant.txt, change the provider to openai, and set both
# values locally. Never commit a real key.
OPENAI_MODEL=
OPENAI_API_KEY=
# Add provider-specific NASA credentials only after choosing an access method.
