# Copy outside the repository, chmod 600; pass with docker compose --env-file.
STAGING_DOMAIN=staging.agrosphere.internal
STAGING_ORIGIN=https://staging.agrosphere.internal:8443
STAGING_USER=reviewer
# Generate interactively: docker run --rm -it caddy:2-alpine caddy hash-password
# Single quotes preserve bcrypt dollar signs in Compose env files.
STAGING_PASSWORD_HASH='REPLACE_WITH_CADDY_BCRYPT_HASH'
